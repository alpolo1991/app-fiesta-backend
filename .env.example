# Copia este archivo como .env y ajusta los valores.
# En Render/Vercel estas mismas claves van como Environment Variables.

# Entorno: development (local, logs detallados) | production (Render, logs mínimos)
NODE_ENV=development

# Secreto JWT (OBLIGATORIO en producción: genera uno largo y único)
JWT_SECRET=fiesta-secret-cambiar-en-produccion
# Puerto (Render lo pone solo con su variable PORT)
PORT=4000
# Frontend(s) permitidos por CORS, separados por comas
# Ej: FRONTEND_URL=https://fiesta.vercel.app,https://fiesta-git-main.vercel.app
FRONTEND_URL=http://localhost:5173

# --- Persistencia (Render: disco en /data) ---
# FIESTA_DB_PATH=/data/fiesta.db
# FIESTA_UPLOADS_DIR=/data/uploads   # solo modo local (sin Cloudinary)
# Fase 2 (DB en la nube): se usará DATABASE_URL y será el único cambio (ver src/config.js).
# DATABASE_URL=

# --- Imágenes en Cloudinary (producción recomendada) ---
# Sin estas 3 variables se usa disco local automáticamente.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Carpeta dentro de Cloudinary (opcional, default: fiesta)
# CLOUDINARY_FOLDER=fiesta
